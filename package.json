{
  "name": "anyacsv",
  "displayName": "AnyaCSV",
  "icon": "assets/CSV-icon-256.png",
  "description": "Detect, preview, and lint CSV and other delimited files.",
  "version": "0.2.3",
  "publisher": "Sanyam",
  "repository": {
    "type": "git",
    "url": "https://github.com/snymkmr/anyaCSV.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test"
  },
  "contributes": {
    "languages": [
      {
        "id": "csv",
        "aliases": [
          "csv",
          "AnyaCSV"
        ],
        "extensions": [
          ".csv"
        ]
      },
      {
        "id": "tsv",
        "aliases": [
          "tsv",
          "AnyaCSV TSV"
        ],
        "extensions": [
          ".tsv",
          ".tab"
        ]
      },
      {
        "id": "csv (semicolon)",
        "aliases": [
          "csv (semicolon)"
        ]
      },
      {
        "id": "csv (whitespace)",
        "aliases": [
          "csv (whitespace)"
        ]
      },
      {
        "id": "csv (pipe)",
        "aliases": [
          "csv (pipe)"
        ],
        "extensions": [
          ".psv"
        ]
      },
      {
        "id": "dynamic csv",
        "aliases": [
          "dynamic csv"
        ],
        "extensions": [
          ".ssv",
          ".dsv"
        ]
      }
    ],
    "commands": [
      {
        "command": "anyacsv.enableForCurrentFile",
        "title": "AnyaCSV: Enable for Current File"
      },
      {
        "command": "anyacsv.setDelimiter",
        "title": "AnyaCSV: Set Delimiter"
      },
      {
        "command": "anyacsv.setDelimiterFromSelection",
        "title": "AnyaCSV: Set Separator from Selection"
      },
      {
        "command": "anyacsv.autoDetectDelimiter",
        "title": "AnyaCSV: Auto Detect Delimiter"
      },
      {
        "command": "anyacsv.showLint",
        "title": "AnyaCSV: Show Lint"
      },
      {
        "command": "anyacsv.previewTable",
        "title": "AnyaCSV: Preview as Table",
        "icon": "$(table)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "anyacsv.previewTable",
          "when": "anyacsv.isDelimited",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "anyacsv.previewTable",
          "when": "anyacsv.isDelimited || resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .tab || resourceExtname == .psv || resourceExtname == .ssv || resourceExtname == .dsv || resourceExtname == .txt",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "anyacsv.previewTable",
          "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .tab || resourceExtname == .psv || resourceExtname == .ssv || resourceExtname == .dsv || resourceExtname == .txt",
          "group": "2_workspace@1"
        }
      ]
    },
    "configuration": {
      "title": "AnyaCSV",
      "properties": {
        "anyacsv.delimiter": {
          "type": "string",
          "default": "auto",
          "description": "Field separator to use, or 'auto' to detect it. Use \\t to represent a tab or enter any literal separator."
        },
        "anyacsv.quoteCharacter": {
          "type": "string",
          "default": "\"",
          "description": "Character used to quote fields. Set to an empty string to disable quoting."
        },
        "anyacsv.headerRow": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "description": "One-based row containing column names. Set to 0 when the file has no header."
        },
        "anyacsv.ignoreEmptyLines": {
          "type": "boolean",
          "default": true,
          "description": "Skip completely blank lines when checking row widths."
        },
        "anyacsv.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Detect delimited content in CSV, Plain Text, and .txt files."
        },
        "anyacsv.autoDetectSampleRows": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 200,
          "description": "Maximum number of logical records to inspect during separator autodetection."
        },
        "anyacsv.autoDetectSeparators": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional separator characters or strings to try during autodetection. Use a JSON tab escape (\\t) for a tab."
        }
      }
    }
  }
}
