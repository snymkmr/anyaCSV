{
  "name": "anyacsv",
  "displayName": "AnyaCSV",
  "icon": "assets/CSV-icon-256.png",
  "description": "Detect, preview, and lint CSV and other delimited files.",
  "version": "0.2.10",
  "publisher": "Sanyam",
  "repository": {
    "type": "git",
    "url": "https://github.com/snymkmr/anyaCSV.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:csv",
    "onLanguage:tsv",
    "onLanguage:csv (semicolon)",
    "onLanguage:csv (whitespace)",
    "onLanguage:csv (pipe)",
    "onLanguage:dynamic csv",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package -o dist/"
  },
  "contributes": {
    "languages": [
      {
        "id": "csv",
        "aliases": [
          "csv",
          "AnyaCSV"
        ],
        "extensions": [
          ".csv"
        ]
      },
      {
        "id": "tsv",
        "aliases": [
          "tsv",
          "AnyaCSV TSV"
        ],
        "extensions": [
          ".tsv",
          ".tab"
        ]
      },
      {
        "id": "csv (semicolon)",
        "aliases": [
          "csv (semicolon)"
        ]
      },
      {
        "id": "csv (whitespace)",
        "aliases": [
          "csv (whitespace)"
        ]
      },
      {
        "id": "csv (pipe)",
        "aliases": [
          "csv (pipe)"
        ],
        "extensions": [
          ".psv"
        ]
      },
      {
        "id": "dynamic csv",
        "aliases": [
          "dynamic csv"
        ],
        "extensions": [
          ".ssv",
          ".dsv"
        ]
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "dynamic csv",
        "scopes": {
          "anyacsvColumn1": ["anyacsvColumn1"],
          "anyacsvColumn2": ["keyword.anyacsvColumn2"],
          "anyacsvColumn3": ["entity.name.function.anyacsvColumn3"],
          "anyacsvColumn4": ["comment.anyacsvColumn4"],
          "anyacsvColumn5": ["string.anyacsvColumn5"],
          "anyacsvColumn6": ["variable.parameter.anyacsvColumn6"],
          "anyacsvColumn7": ["constant.numeric.anyacsvColumn7"],
          "anyacsvColumn8": ["entity.name.type.anyacsvColumn8"],
          "anyacsvColumn9": ["markup.bold.anyacsvColumn9"],
          "anyacsvColumn10": ["invalid.anyacsvColumn10"],
          "comment": ["comment"]
        }
      }
    ],
    "configurationDefaults": {
      "[dynamic csv][csv][tsv][csv (semicolon)][csv (pipe)][csv (whitespace)]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "grammars": [
      {
        "language": "csv",
        "scopeName": "source.anyacsv.csv",
        "path": "./syntaxes/csv.tmLanguage.json"
      },
      {
        "language": "tsv",
        "scopeName": "source.anyacsv.tsv",
        "path": "./syntaxes/tsv.tmLanguage.json"
      },
      {
        "language": "csv (semicolon)",
        "scopeName": "source.anyacsv.semicolon",
        "path": "./syntaxes/semicolon.tmLanguage.json"
      },
      {
        "language": "csv (pipe)",
        "scopeName": "source.anyacsv.pipe",
        "path": "./syntaxes/pipe.tmLanguage.json"
      },
      {
        "language": "csv (whitespace)",
        "scopeName": "source.anyacsv.whitespace",
        "path": "./syntaxes/whitespace.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "anyacsv.enableForCurrentFile",
        "title": "AnyaCSV: Enable for Current File"
      },
      {
        "command": "anyacsv.setDelimiter",
        "title": "AnyaCSV: Set Delimiter"
      },
      {
        "command": "anyacsv.setDelimiterFromSelection",
        "title": "AnyaCSV: Set Separator from Selection"
      },
      {
        "command": "anyacsv.autoDetectDelimiter",
        "title": "AnyaCSV: Auto Detect Delimiter"
      },
      {
        "command": "anyacsv.showLint",
        "title": "AnyaCSV: Show Lint"
      },
      {
        "command": "anyacsv.previewTable",
        "title": "AnyaCSV: Preview as Table",
        "icon": "$(table)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "anyacsv.previewTable",
          "when": "anyacsv.isDelimited",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "anyacsv.previewTable",
          "when": "anyacsv.isDelimited || resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .tab || resourceExtname == .psv || resourceExtname == .ssv || resourceExtname == .dsv",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "anyacsv.showLint",
          "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .tab || resourceExtname == .psv || resourceExtname == .ssv || resourceExtname == .dsv",
          "group": "2_workspace@0"
        },
        {
          "command": "anyacsv.previewTable",
          "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .tab || resourceExtname == .psv || resourceExtname == .ssv || resourceExtname == .dsv",
          "group": "2_workspace@1"
        }
      ]
    },
    "configuration": {
      "title": "AnyaCSV",
      "properties": {
        "anyacsv.delimiter": {
          "type": "string",
          "default": "auto",
          "description": "Field separator to use, or 'auto' to detect it. Use \\t to represent a tab or enter any literal separator."
        },
        "anyacsv.quoteCharacter": {
          "type": "string",
          "default": "\"",
          "description": "Character used to quote fields. Set to an empty string to disable quoting."
        },
        "anyacsv.headerRow": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "description": "One-based row containing column names. Set to 0 when the file has no header."
        },
        "anyacsv.ignoreEmptyLines": {
          "type": "boolean",
          "default": true,
          "description": "Skip completely blank lines when checking row widths."
        },
        "anyacsv.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Detect delimited content in CSV and Plain Text documents. .txt files require an AnyaCSV language mode or explicit per-file activation."
        },
        "anyacsv.autoDetectSampleRows": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 200,
          "description": "Maximum number of logical records to inspect during separator autodetection."
        },
        "anyacsv.autoDetectSeparators": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional separator characters or strings to try during autodetection. Use a JSON tab escape (\\t) for a tab."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.0"
  }
}
